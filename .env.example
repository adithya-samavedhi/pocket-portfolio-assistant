# Copy this file to `.env` and fill in your key(s).
# `.env` is gitignored — never commit real keys.
#
#   cp .env.example .env
#   # then edit .env

# --- LLM model (any LiteLLM model string) ---
# Default is Gemini's free tier. Switch providers by changing this one line
# and setting the matching key below.
LLM_MODEL=gemini/gemini-flash-latest
#   gemini/gemini-flash-lite-latest   # faster, more generous free quota, weaker reasoning
#   gemini/gemini-3.5-flash           # pin a specific version instead of the alias
#   anthropic/claude-sonnet-4-5
#   openai/gpt-4o-mini
#   ollama/llama3.1                   # local, no key

# --- Provider API key (only the one for your chosen model is needed) ---
# Get a Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# --- LLM reliability / cost (all optional) ---
# Free tiers are quota-limited: Gemini's flash tier allows only ~20 requests PER
# DAY per model, and one orchestrator question costs up to 4 calls. Quotas are
# per-model, so switching LLM_MODEL gives you a fresh allowance.
#
# Comma-separated failover chain, tried in order when the primary is exhausted.
# Needs the matching key above for each entry.
# LLM_FALLBACK_MODELS=gemini/gemini-flash-lite-latest,groq/llama-3.3-70b-versatile
#
# Completions are cached to data/cache/llm/ keyed on (model, system, user,
# temperature) — this is what makes the eval sets re-runnable for free. Editing
# a prompt invalidates its entries automatically. Set to 0 to always call live.
# LLM_CACHE=1
#
# Retries on a per-minute rate limit (daily quotas fail fast — waiting won't help).
# LLM_MAX_RETRIES=5

# --- Market data (optional) ---
# Leave blank to use yfinance (keyless). Set a Finnhub key to use Finnhub for
# quotes/valuation instead (official, better for scheduled use). https://finnhub.io
# FINNHUB_API_KEY=

# --- EDGAR (recommended) ---
# SEC asks that requests identify the requester (name + email). Without this,
# downloads use a placeholder that SEC may throttle or block.
SEC_USER_AGENT=you@example.com Your Name
